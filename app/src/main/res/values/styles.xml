<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#53565B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <!-- Readable dialog actions on a near-black AMOLED surface. -->
    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#F4F3EF</item>
        <item name="android:colorBackground">#161616</item>
        <item name="android:textColorPrimary">#F4F3EF</item>
    </style>
</resources>
